{
    "format_version": "1.26.40",
    "minecraft:block": {
        "description": {
            "identifier": "confluence:pearl_log",
            "menu_category": {
                "category": "nature",
                "group": "minecraft:itemGroup.name.log"
            },
            "traits": {
                "minecraft:placement_position": {
                    "enabled_states": [
                        "minecraft:block_face"
                    ]
                }
            }
        },
        "components": {
            "minecraft:display_name": "tile.confluence:pearl_log.name",
            "minecraft:geometry": {
                "identifier": "minecraft:geometry.full_block",
                "uv_lock": true
            },
            "minecraft:material_instances": {
                "up": {
                    "texture": "confluence:pearl_log_end",
                    "render_method": "opaque"
                },
                "down": {
                    "texture": "confluence:pearl_log_end",
                    "render_method": "opaque"
                },
                "*": {
                    "texture": "confluence:pearl_log_side",
                    "render_method": "opaque"
                }
            },
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 2,
                "item_specific_speeds": [
                    {
                        "item": {
                            "tags": "q.all_tags('minecraft:is_axe','minecraft:wooden_tier') && !q.any_tag('confluence:is_tool')"
                        },
                        "destroy_speed": 1.5
                    },
                    {
                        "item": {
                            "tags": "q.all_tags('minecraft:is_axe','minecraft:stone_tier') && !q.any_tag('confluence:is_tool')"
                        },
                        "destroy_speed": 0.75
                    },
                    {
                        "item": {
                            "tags": "q.all_tags('minecraft:is_axe','minecraft:copper_tier') && !q.any_tag('confluence:is_tool')"
                        },
                        "destroy_speed": 0.6
                    },
                    {
                        "item": {
                            "tags": "q.all_tags('minecraft:is_axe','minecraft:golden_tier') && !q.any_tag('confluence:is_tool')"
                        },
                        "destroy_speed": 0.25
                    },
                    {
                        "item": {
                            "tags": "q.all_tags('minecraft:is_axe','minecraft:iron_tier') && !q.any_tag('confluence:is_tool')"
                        },
                        "destroy_speed": 0.5
                    },
                    {
                        "item": {
                            "tags": "q.all_tags('minecraft:is_axe','minecraft:diamond_tier') && !q.any_tag('confluence:is_tool')"
                        },
                        "destroy_speed": 0.375
                    },
                    {
                        "item": {
                            "tags": "q.all_tags('minecraft:is_axe','minecraft:netherite_tier') && !q.any_tag('confluence:is_tool')"
                        },
                        "destroy_speed": 0.333
                    }
                ]
            },
            "minecraft:destructible_by_explosion": {
                "explosion_resistance": 2
            },
            "minecraft:light_dampening": 15,
            "minecraft:flammable": {
                "catch_chance_modifier": 5,
                "destroy_chance_modifier": 20
            },
            "minecraft:map_color": "#a58273",
            "minecraft:tags": [
                "confluence:axe",
                "minecraft:is_hatchet_item_destructible"
            ]
        },
        "permutations": [
            {
                "condition": "q.block_state('minecraft:block_face') == 'north' || q.block_state('minecraft:block_face') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            90,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:block_face') == 'east' || q.block_state('minecraft:block_face') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            90
                        ]
                    }
                }
            }
        ]
    }
}
