{
    "format_version": "1.26.40",
    "minecraft:block": {
        "description": {
            "identifier": "confluence:stony_log",
            "menu_category": {
                "category": "nature",
                "group": "minecraft:itemGroup.name.log"
            },
            "traits": {
                "minecraft:placement_position": {
                    "enabled_states": [
                        "minecraft:block_face"
                    ]
                }
            }
        },
        "components": {
            "minecraft:display_name": "tile.confluence:stony_log.name",
            "minecraft:geometry": {
                "identifier": "minecraft:geometry.full_block",
                "uv_lock": true
            },
            "minecraft:material_instances": {
                "up": {
                    "texture": "confluence:stony_log_end",
                    "render_method": "opaque"
                },
                "down": {
                    "texture": "confluence:stony_log_end",
                    "render_method": "opaque"
                },
                "*": {
                    "texture": "confluence:stony_log_side",
                    "render_method": "opaque"
                }
            },
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 1.5,
                "item_specific_speeds": [
                    {
                        "item": {
                            "tags": "q.all_tags('minecraft:is_pickaxe','minecraft:wooden_tier') && !q.any_tag('confluence:is_tool')"
                        },
                        "destroy_speed": 1.125
                    },
                    {
                        "item": {
                            "tags": "q.all_tags('minecraft:is_pickaxe','minecraft:stone_tier') && !q.any_tag('confluence:is_tool')"
                        },
                        "destroy_speed": 0.563
                    },
                    {
                        "item": {
                            "tags": "q.all_tags('minecraft:is_pickaxe','minecraft:copper_tier') && !q.any_tag('confluence:is_tool')"
                        },
                        "destroy_speed": 0.45
                    },
                    {
                        "item": {
                            "tags": "q.all_tags('minecraft:is_pickaxe','minecraft:golden_tier') && !q.any_tag('confluence:is_tool')"
                        },
                        "destroy_speed": 0.188
                    },
                    {
                        "item": {
                            "tags": "q.all_tags('minecraft:is_pickaxe','minecraft:iron_tier') && !q.any_tag('confluence:is_tool')"
                        },
                        "destroy_speed": 0.375
                    },
                    {
                        "item": {
                            "tags": "q.all_tags('minecraft:is_pickaxe','minecraft:diamond_tier') && !q.any_tag('confluence:is_tool')"
                        },
                        "destroy_speed": 0.281
                    },
                    {
                        "item": {
                            "tags": "q.all_tags('minecraft:is_pickaxe','minecraft:netherite_tier') && !q.any_tag('confluence:is_tool')"
                        },
                        "destroy_speed": 0.25
                    }
                ]
            },
            "minecraft:destructible_by_explosion": {
                "explosion_resistance": 6
            },
            "minecraft:light_dampening": 15,
            "minecraft:map_color": "#686a6b",
            "minecraft:tags": [
                "confluence:level_1",
                "confluence:pickaxe",
                "minecraft:is_pickaxe_item_destructible"
            ],
            "minecraft:loot": "loot_tables/blocks/stony_log.json"
        },
        "permutations": [
            {
                "condition": "q.block_state('minecraft:block_face') == 'north' || q.block_state('minecraft:block_face') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            90,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:block_face') == 'east' || q.block_state('minecraft:block_face') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            90
                        ]
                    }
                }
            }
        ]
    }
}
